# Changes to Debian's amd64 config; build.sh checks each in the final .config.

# 1000 Hz timer: finer time slices, lower input and audio latency (Debian: 250).
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Full preemption: lowest scheduling latency under load (Debian: lazy).
# PREEMPT_DYNAMIC stays, so preempt=lazy on the kernel command line switches back.
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y

# zstd module compression: faster module loading at boot (Debian: xz).
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_XZ is not set

# teo idle governor built, not default: cpuidle.governor=teo selects it.
CONFIG_CPU_IDLE_GOV_TEO=y

# No console flash when the graphical boot screen starts.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Interrupt time counted apart from tasks: accurate CPU usage and scheduling.
CONFIG_IRQ_TIME_ACCOUNTING=y

# Modules signed with a key made for this build and not kept.
CONFIG_MODULE_SIG_ALL=y

# As Debian: Rust support; the build needs the Rust toolchain.
CONFIG_RUST=y
